# ==============================================================================
# VridhaSuraksha Environment Variables (.env.example)
# Copy to .env.local for local development. Never commit real values.
# ==============================================================================

# Database: PostgreSQL on Neon or Supabase (use pooled connection string)
DATABASE_URL="postgresql://username:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# AI: Google Gemini API key (@google/genai)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3-flash-preview"

# Email: Resend HTTPS API key (Render & Vercel friendly, no blocked SMTP ports)
RESEND_API_KEY=""
EMAIL_FROM="VridhaSuraksha <onboarding@resend.dev>"

# Security & Encryption:
# Generate with: openssl rand -base64 48
JWT_SECRET=""
CRON_SECRET=""

# Generate with: openssl rand -base64 32 (Must be 32 bytes base64-encoded for AES-256-GCM)
ENCRYPTION_KEY=""

# Public URL of the app (used in reminder action links)
APP_URL="http://localhost:3000"

# Optional settings
DATA_BACKEND="prisma"
DEMO_MODE="true"
DEMO_INBOX=""
