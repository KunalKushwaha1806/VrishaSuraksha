# Copy to .env.local for local development. Never commit real values.
# In production (Cloud Run) these come from Secret Manager; see README "Deploy".

# Public URL of the app (used in email links). Optional on Render and Vercel, which provide it.
APP_URL=http://localhost:3000

# Secrets: generate with `openssl rand -base64 48` (JWT/CRON) and `openssl rand -base64 32` (ENCRYPTION_KEY)
JWT_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# "memory" for local development without Google Cloud; "firestore" in production (default when NODE_ENV=production)
DATA_BACKEND=memory
GOOGLE_CLOUD_PROJECT=
# Vercel/Render only: a Firebase service-account key (the whole JSON, or base64 of it).
# Not needed on Cloud Run, which signs in automatically.
GOOGLE_CREDENTIALS=

# Gemini (Google AI Studio key). Optional: AI features show a manual fallback without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Email over SMTP, e.g. Gmail with an App Password (port 587). Without it, emails are logged, not sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VridhaSuraksha <you@gmail.com>"

# Google Cloud Text-to-Speech for Hindi/English voice (uses the Cloud Run service account)
TTS_ENABLED=false

# One-click demo circle. DEMO_INBOX sends demo emails to you+elder@, you+caretaker@ ... (plus-addressing)
DEMO_MODE=true
DEMO_INBOX=
