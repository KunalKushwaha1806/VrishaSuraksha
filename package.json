{
  "name": "vridhasuraksha",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate.mjs && next build",
    "build:prod": "prisma generate && prisma migrate deploy && next build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "seed": "node scripts/seed.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@google-cloud/text-to-speech": "^7.2.0",
    "@google/genai": "^3.3.0",
    "@prisma/client": "6.19.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "next": "15.5.29",
    "nodemailer": "^10.5.0",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.38.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.10.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.33"
    }
  }
